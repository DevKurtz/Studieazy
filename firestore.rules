rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email.lower() == 'demesakurtdaryl@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'])
      );
    }

    // Users — Users can only update their own profile and CANNOT escalate their own role. Admins have full access.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && (
        !('role' in request.resource.data) ||
        request.resource.data.role == 'user' ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        ))
      );
      allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      match /study_folders/{folderId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /study_materials/{materialId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /study_highlights/{highlightId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Quizzes — Users can read and create quizzes, but can only update/delete their own quizzes. Admins can manage all.
    match /quizzes/{quizId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // Questions — Authenticated users can read and write questions.
    match /questions/{questionId} {
      allow read, write: if isSignedIn();
    }

    // Support Tickets — Users can create tickets and read their own. Only admins can view all, update, or delete.
    match /support_tickets/{ticketId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isSignedIn() && isAdmin();
    }

    // Error Logs — Any client can log errors. Only admins can view, resolve, or clear logs.
    match /error_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if isSignedIn() && isAdmin();
    }

    // System config may contain provider credentials. Never expose it to all
    // signed-in clients; move student-facing AI calls behind a trusted backend.
    match /system_config/{docId} {
      allow read: if isAdmin();
      allow write: if isSignedIn() && isAdmin();
    }

    // OTP codes — Managed strictly by backend Admin SDK (serverless functions), disallowed for client apps directly.
    match /otp_codes/{docId} {
      allow read, write: if false;
    }
  }
}
